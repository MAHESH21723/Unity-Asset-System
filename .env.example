# Copy to .env and adjust. Every value is optional: the app runs fully offline
# with the built-in rule-based engine when no API key is set.

# Flask session/CSRF signing key. If empty, a random key is generated at startup
# (sessions then reset on every restart). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to 1 only for local development (enables the Flask debugger and reloader).
FLASK_DEBUG=0

# Host/port for `python app.py` (defaults keep the server local-only).
HOST=127.0.0.1
PORT=5000

# SQLite file location (created automatically on startup).
DATABASE_PATH=unity_ai.db

# Optional AI providers (install with: pip install -r requirements-ai.txt).
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini
